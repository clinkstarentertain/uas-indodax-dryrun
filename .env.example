# Salin ke .env (lokal) atau isi di Vercel > Project > Settings > Environment Variables. JANGAN komit .env.
# Secret untuk Authorization: Bearer <CRON_SECRET> di /api/tick dan /api/control (min. 16 karakter acak).
CRON_SECRET=
# Token read-write Vercel Blob (otomatis terisi bila store Blob ditautkan ke project).
BLOB_READ_WRITE_TOKEN=
# URL deployment untuk skrip lokal (tarik_log / scheduler lokal), mis. https://<project>.vercel.app
BOT_URL=
# Opsional, uji lokal tanpa Blob: folder store
# STORE_DIR=tmp/store
# Kill switch TIDAK lewat env (env butuh redeploy) - pakai POST /api/control.
